# =============================================================================
#  BlaxkVERSE — environment template
#
#  Copy this to `.env` for local development, or paste the values into the
#  Vercel project's Environment Variables screen for a deployment. `.env` is
#  gitignored; this file is not, and it must never hold a real credential.
#
#  Every value below is SERVER-SIDE ONLY. None is prefixed with NEXT_PUBLIC_,
#  VITE_ or anything else that would inline it into a browser bundle. The
#  build does not read these at all — they are read by the serverless
#  functions in `api/` at request time, which is the only place they exist.
#
#  The site runs without them: with no Redis URL it accepts a page view and
#  discards it, and without ADMIN_TOKEN the dashboard stays disabled. That is
#  deliberate — a missing secret degrades to a truthful message, never to a
#  silent success or a crash.
#
#  The contact form is NOT configured here. It posts from the browser to
#  EmailJS, with its public key and template ids pasted into
#  `site/assets/js/emailjs-config.js`. No contact credential belongs in this
#  file or in the hosting project's environment variables.
# =============================================================================

# --- Visitor tracking: makes the dashboard show real numbers ----------------
# Any Redis-over-HTTP store works. Vercel KV and Upstash both expose the same
# REST shape. Free tiers are far beyond what a portfolio site needs.
#
#   Vercel:  Project -> Storage -> Create Database -> KV -> connect to project.
#            Vercel injects KV_REST_API_URL and KV_REST_API_TOKEN for you.
#   Upstash: https://console.upstash.com -> Create Database -> REST API tab.
#            Copy UPSTASH_REDIS_REST_URL and UPSTASH_REDIS_REST_TOKEN.
#
# Set ONE pair. If both are present the KV_ pair wins.
KV_REST_API_URL=
KV_REST_API_TOKEN=

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- The dashboard password -------------------------------------------------
# /admin asks for this once and keeps it in sessionStorage for that tab.
# Anything long and random: `openssl rand -hex 32`.
#
# This is the only thing standing between the public internet and your visitor
# counts. Without it set, /api/stats refuses to answer at all.
ADMIN_TOKEN=

# --- Local development only -------------------------------------------------
# The dev server binds this port. Defaults to 4173.
PORT=4173

# Only used by `npm run dev` so country statistics can be tested without a
# real Vercel edge. Ignored in production — Vercel supplies the header itself.
DEV_FAKE_COUNTRY=NG
